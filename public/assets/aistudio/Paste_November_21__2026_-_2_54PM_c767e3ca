@Composable
fun GameTutorialDialog(onDone: () -> Unit) {
    val pages = GuideContent.tutorialPages
    var page by rememberSaveable { mutableIntStateOf(0) }
    val sec = pages[page]
    val last = page == pages.lastIndex

    Dialog(onDismissRequest = {}, properties = DialogProperties(dismissOnBackPress = false, dismissOnClickOutside = false)) {
        Surface(
            color = ErSimSurface,
            shape = RoundedCornerShape(20.dp),
            border = BorderStroke(1.dp, ErSimBorder),
            modifier = Modifier.fillMaxWidth().testTag("game_tutorial")
        ) {
            Column(modifier = Modifier.padding(20.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
                Row(verticalAlignment = Alignment.CenterVertically) {
                    Text("HOW TO PLAY • ${page + 1}/${pages.size}", color = ErSimMint, fontSize = 11.sp, fontWeight = FontWeight.ExtraBold, letterSpacing = 1.2.sp, modifier = Modifier.weight(1f))
                    TextButton(onClick = onDone, modifier = Modifier.testTag("tutorial_skip")) { Text("Skip", color = ErSimTextMuted) }
                }
                Box(
                    contentAlignment = Alignment.Center,
                    modifier = Modifier.size(52.dp).background(ErSimRaisedSurface, RoundedCornerShape(14.dp))
                ) { Icon(sec.icon, contentDescription = null, tint = ErSimMint, modifier = Modifier.size(28.dp)) }
                Text(sec.title, color = ErSimTextPrimary, fontSize = 20.sp, fontWeight = FontWeight.ExtraBold)
                Column(verticalArrangement = Arrangement.spacedBy(6.dp)) { sec.points.forEach { GuidePoint(it) } }
                Row(horizontalArrangement = Arrangement.spacedBy(6.dp), modifier = Modifier.align(Alignment.CenterHorizontally)) {
                    pages.indices.forEach { i ->
                        Box(Modifier.size(if (i == page) 10.dp else 7.dp).background(if (i == page) ErSimMint else ErSimBorder, CircleShape))
                    }
                }
                Row(horizontalArrangement = Arrangement.spacedBy(10.dp), modifier = Modifier.fillMaxWidth()) {
                    if (page > 0) {
                        OutlinedButton(
                            onClick = { page-- },
                            border = BorderStroke(1.dp, ErSimBorder),
                            colors = ButtonDefaults.outlinedButtonColors(contentColor = ErSimTextPrimary),
                            shape = RoundedCornerShape(12.dp),
                            modifier = Modifier.weight(1f).height(48.dp)
                        ) { Text("Back") }
                    }
                    Button(
                        onClick = { if (last) onDone() else page++ },
                        colors = ButtonDefaults.buttonColors(containerColor = ErSimMint, contentColor = ErSimBg),
                        shape = RoundedCornerShape(12.dp),
                        modifier = Modifier.weight(1f).height(48.dp).testTag("tutorial_next")
                    ) { Text(if (last) "Start the case" else "Next", fontWeight = FontWeight.Bold) }
                }
            }
        }
    }
}
